      {
        "name": "01-basics-types-and-memory",
        "type": "directory",
        "children": [
          {
            "name": "README.md",
            "type": "file",
            "content": "# 01 — Exact-Width Types & Endianness\n\n## 🎯 `<stdint.h>`\nAlways use exact-width integer types (`uint8_t`, `int32_t`, `uint64_t`) in systems code to guarantee portable memory representations across architectures.\n"
          },
          {
            "name": "example.c",
            "type": "file",
            "content": "#include <stdio.h>\n#include <stdint.h>\n\nvoid check_endianness(void) {\n    uint16_t x = 0x0001;\n    uint8_t* byte_ptr = (uint8_t*)&x;\n    if (*byte_ptr == 1) {\n        printf(\"System Endianness: Little-Endian (x86/ARM default)\\n\");\n    } else {\n        printf(\"System Endianness: Big-Endian\\n\");\n    }\n}\n\nint main(void) {\n    printf(\"=== 01: Endianness Detection ===\\n\");\n    check_endianness();\n    return 0;\n}\n"
          },
          {
            "name": "exercise",
            "type": "directory",
            "children": [
              {
                "name": "starter.c",
                "type": "file",
                "content": "// TODO: Implement a function 'swap_uint16(uint16_t val)' to convert endianness.\n#include <stdint.h>\n#include <stdio.h>\n\nuint16_t swap_uint16(uint16_t val) {\n    // FILL HERE\n    return 0;\n}\n\nint main(void) { return 0; }\n"
              },
              {
                "name": "solution.c",
                "type": "file",
                "content": "#include <stdint.h>\n#include <stdio.h>\n\nuint16_t swap_uint16(uint16_t val) {\n    return (val << 8) | (val >> 8);\n}\n\nint main(void) {\n    uint16_t original = 0x1234;\n    uint16_t swapped = swap_uint16(original);\n    printf(\"Original: 0x%04X | Swapped: 0x%04X\\n\", original, swapped);\n    return 0;\n}\n"
              }
            ]
          }
        ]
      },
      {
        "name": "02-pointers-and-address-arithmetic",
        "type": "directory",
        "children": [
          {
            "name": "README.md",
            "type": "file",
            "content": "# 02 — Pointer Scaling & Address Arithmetic\n\n## 🎯 Pointer Arithmetic\nAdding 1 to a pointer `T*` advances the memory address by `sizeof(T)` bytes.\n"
          },
          {
            "name": "example.c",
            "type": "file",
            "content": "#include <stdio.h>\n\nint main(void) {\n    int arr[3] = {10, 20, 30};\n    int* ptr = arr;\n\n    printf(\"=== 02: Pointer Arithmetic ===\\n\");\n    printf(\"Address of arr[0]: %p | Value: %d\\n\", (void*)ptr, *ptr);\n    ptr++; // Advances by sizeof(int) = 4 bytes\n    printf(\"Address of arr[1]: %p | Value: %d\\n\", (void*)ptr, *ptr);\n    return 0;\n}\n"
          },
          {
            "name": "exercise",
            "type": "directory",
            "children": [
              {
                "name": "starter.c",
                "type": "file",
                "content": "// TODO: Implement a custom 'my_memcpy(void* dest, const void* src, size_t n)' function.\n#include <stddef.h>\n\nvoid* my_memcpy(void* dest, const void* src, size_t n) {\n    // FILL HERE\n    return dest;\n}\n\nint main(void) { return 0; }\n"
              },
              {
                "name": "solution.c",
                "type": "file",
                "content": "#include <stddef.h>\n#include <stdio.h>\n\nvoid* my_memcpy(void* dest, const void* src, size_t n) {\n    unsigned char* d = (unsigned char*)dest;\n    const unsigned char* s = (const unsigned char*)src;\n    for (size_t i = 0; i < n; i++) {\n        d[i] = s[i];\n    }\n    return dest;\n}\n\nint main(void) {\n    char src[] = \"Trak Systems\";\n    char dst[20];\n    my_memcpy(dst, src, sizeof(src));\n    printf(\"Copied string: %s\\n\", dst);\n    return 0;\n}\n"
              }
            ]
          }
        ]
      },
      {
        "name": "03-memory-allocation-malloc-free",
        "type": "directory",
        "children": [
          {
            "name": "README.md",
            "type": "file",
            "content": "# 03 — Dynamic Memory Allocation (`malloc`, `calloc`, `free`)\n\n## 🎯 Golden Rules of C Memory\n1. Always check for `NULL` after `malloc`/`calloc`.\n2. Set pointers to `NULL` immediately after `free()` to prevent dangling pointers.\n3. Never double-free memory.\n"
          },
          {
            "name": "example.c",
            "type": "file",
            "content": "#include <stdio.h>\n#include <stdlib.h>\n\nint main(void) {\n    int* numbers = (int*)malloc(5 * sizeof(int));\n    if (!numbers) {\n        perror(\"malloc failed\");\n        return 1;\n    }\n\n    for (int i = 0; i < 5; i++) numbers[i] = (i + 1) * 10;\n\n    printf(\"=== 03: Dynamic Memory ===\\n\");\n    for (int i = 0; i < 5; i++) printf(\"%d \", numbers[i]);\n    printf(\"\\n\");\n\n    free(numbers);\n    numbers = NULL;\n    return 0;\n}\n"
          },
          {
            "name": "exercise",
            "type": "directory",
            "children": [
              {
                "name": "starter.c",
                "type": "file",
                "content": "// TODO: Allocate dynamic integer buffer, populate it, and safely free it.\n"
              },
              {
                "name": "solution.c",
                "type": "file",
                "content": "#include <stdio.h>\n#include <stdlib.h>\n\nint main(void) {\n    size_t count = 10;\n    int* buffer = (int*)calloc(count, sizeof(int));\n    if (!buffer) return 1;\n    buffer[0] = 42;\n    printf(\"Buffer first element: %d\\n\", buffer[0]);\n    free(buffer);\n    buffer = NULL;\n    return 0;\n}\n"
              }
            ]
          }
        ]
      },
      {
        "name": "04-arrays-and-pointer-decay",
        "type": "directory",
