                "content": "#include <stdio.h>\n\nint main(void) {\n    int data[3] = {100, 200, 300};\n    FILE* f = fopen(\"test.bin\", \"wb\");\n    if (f) {\n        fwrite(data, sizeof(int), 3, f);\n        fclose(f);\n    }\n    printf(\"Binary data written.\\n\");\n    return 0;\n}\n"
