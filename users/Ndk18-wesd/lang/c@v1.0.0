          {
            "name": "README.md",
            "type": "file",
            "content": "# 08 — Function Pointers & Callback Dispatch\n\n## 🎯 Syntax\n`return_type (*func_ptr_name)(param_types)`\n"
          },
          {
            "name": "example.c",
            "type": "file",
            "content": "#include <stdio.h>\n\nint add(int a, int b) { return a + b; }\nint multiply(int a, int b) { return a * b; }\n\nvoid execute(int (*operation)(int, int), int x, int y) {\n    printf(\"Result: %d\\n\", operation(x, y));\n}\n\nint main(void) {\n    execute(add, 5, 3);\n    execute(multiply, 5, 3);\n    return 0;\n}\n"
          },
          {
            "name": "exercise",
            "type": "directory",
            "children": [
              {
                "name": "starter.c",
                "type": "file",
                "content": "// TODO: Implement a comparison callback for standard library qsort.\n"
              },
              {
                "name": "solution.c",
                "type": "file",
                "content": "#include <stdio.h>\n#include <stdlib.h>\n\nint compare_ints(const void* a, const void* b) {\n    int arg1 = *(const int*)a;\n    int arg2 = *(const int*)b;\n    return (arg1 > arg2) - (arg1 < arg2);\n}\n\nint main(void) {\n    int arr[] = {5, 2, 8, 1, 4};\n    qsort(arr, 5, sizeof(int), compare_ints);\n    for (int i = 0; i < 5; i++) printf(\"%d \", arr[i]);\n    printf(\"\\n\");\n    return 0;\n}\n"
              }
            ]
          }
        ]
      },
